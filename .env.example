# ProofPass Environment Configuration

# M4 Intelligence Module Configuration
INTELLIGENCE_LLM_API_KEY=
INTELLIGENCE_LLM_BASE_URL=https://api.openai.com/v1
INTELLIGENCE_LLM_MODEL=gpt-4o-mini
INTELLIGENCE_LLM_TIMEOUT=30
INTELLIGENCE_LLM_MAX_RETRIES=1
INTELLIGENCE_FALLBACK_TO_MOCK=true

# GitHub OAuth App Configuration
GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here
GITHUB_REDIRECT_URI=http://localhost:8000/api/v1/auth/github/callback

# Session Secret (HMAC-SHA256 for signed session cookies)
# If unset, a random 48-byte token will be generated on startup (sessions reset on restart)
SESSION_SECRET=your_long_random_session_secret_here

# Cookie Security (set to true in production with HTTPS)
COOKIE_SECURE=false

# CORS Configuration
FRONTEND_ORIGIN=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Database Persistence
# Defaults to sqlite:///<repo_root>/proofpass.db if unset
DATABASE_URL=sqlite:///./proofpass.db

# Server Port
PORT=8000
# Parts 1 & 3 - recommendations (backend only; NEVER use a VITE_ prefix for these)
# Optional. Without it GitHub search is limited to 10 requests/min per IP; results are cached.
GITHUB_TOKEN=
GITHUB_CACHE_TTL_SECONDS=21600
# Optional semantic skill-NAME matching (needs `pip install sentence-transformers`; off by default)
SEMANTIC_SKILL_MATCHING=false

# --- Accounts & verification (backend only) ---
# Server-side login sessions: days until a session expires (HttpOnly cookie "proofpass_account")
ACCOUNT_SESSION_DAYS=7
# Argon2id cost parameters (defaults are fine; lower only on very small hosts)
# ARGON2_TIME_COST=3
# ARGON2_MEMORY_KIB=65536
# ARGON2_PARALLELISM=2
# Live GitHub verification works unauthenticated but is limited to 60 requests/hour per IP.
# Set GITHUB_TOKEN (above) for realistic use. It is read by the backend only.
# NEVER set in production: enables synthetic fixture repositories for tests/local demos.
# PROOFPASS_OFFLINE_FIXTURES=1

# --- Deployment (Render Free plan, zero cost) ---
# SQLite on Render's Free plan is EPHEMERAL: accounts and passports are erased on every redeploy/restart.
# The app starts anyway and reports it at GET /api/v1/health (persistent_storage:false).
# Course dataset (not committed; licence unverified). Either place the CSV at backend/data/ before building,
# or give an https URL (and optionally its SHA-256) that is fetched at container start-up:
# COURSE_CSV_URL=
# COURSE_CSV_SHA256=
