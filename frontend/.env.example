# ProofPass Frontend Environment Variables

# Set to "true" to force mock verification mode in the browser (default: false)
# When true, skips backend GitHub OAuth and uses mock developer profiles
VITE_USE_MOCK=false

# GitHub tokens must NOT be set here: every VITE_* variable is embedded in the public bundle.
# Use the backend-only GITHUB_TOKEN in the repo-root .env instead.

# Optional Google Gemini API key for AI-suggested milestones on the Learnings page
# Left empty, the page shows a built-in fallback checklist and makes no network call
VITE_GEMINI_MILESTONES_KEY=
